{
  "name": "justlakshmi-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "JustLakshmi - Plan. Track. Thrive. Monorepo workspace.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@justlakshmi/web",
    "dev:web": "npm run dev --workspace=@justlakshmi/web",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@justlakshmi/web",
    "start:web": "npm run start --workspace=@justlakshmi/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "icons": "npm run icons --workspace=@justlakshmi/web",
    "check:pwa": "npm run check:pwa --workspace=@justlakshmi/web",
    "check": "npm run lint && npm run typecheck && npm run build"
  }
}
