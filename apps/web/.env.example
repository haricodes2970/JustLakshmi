# Copy to .env.local for local development. Never commit real credentials or secrets.
# Only NEXT_PUBLIC_* values are exposed to the browser. Never put a service_role key here.

# Backend API base URL (e.g. http://localhost:4000 locally, or deployed Render URL)
# NEXT_PUBLIC_API_BASE_URL=

# Supabase Auth client configuration (used in later phases; publishable key only)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth / Picker public credentials (used for separate drive.file flow; never put client secrets here)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
