    "fastify": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@justlakshmi/config": "*",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
